DEBUG=true
# Explicitly set staging/production there; DEBUG and TESTING must both be false.
APP_ENV=local
DJANGO_SECRET_KEY=change-me-locally
DATABASE_URL=postgresql://enter:enter@127.0.0.1:5433/enter
ALLOWED_HOSTS=127.0.0.1,localhost
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
VITE_API_URL=http://127.0.0.1:8010/api/v1
VITE_LEGAL_CONTENT_APPROVED=false

FRONTEND_URL=http://127.0.0.1:5173
RESUME_MAX_BYTES=5242880
PROFILE_PHOTO_MAX_BYTES=4194304
MEDIA_ROOT=backend/media

# Required when DEBUG=false. Use a private S3/R2-compatible bucket.
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=auto
AWS_S3_ENDPOINT_URL=
# Leave static keys empty on ECS and grant the task role least-privileged access.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
# Hard bound: 1–60 seconds; applies to SMTP socket operations.
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=noreply@example.com
# Explicit local/test opt-in only (also gates issue_local_account_token).
# Staging/production reject this setting if enabled.
EXPOSE_LOCAL_EMAIL_LINKS=false
EMAIL_VERIFICATION_TOKEN_TTL_SECONDS=86400
PASSWORD_RESET_TOKEN_TTL_SECONDS=3600
ACCOUNT_EMAIL_RESEND_COOLDOWN_SECONDS=60
AUTH_TOKEN_TTL_SECONDS=604800
AUTH_COOKIE_NAME=enter_session
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=Lax
AUTH_COOKIE_DOMAIN=
SUBMISSION_CONSENT_VERSION=candidate-profile-sharing-v1

# Publish only after exact complete copies, effective date and hashes are approved.
LEGAL_CONTENT_APPROVED=false
LEGAL_WORKFLOW_PREVIEW=false
LEGAL_EFFECTIVE_DATE=
LEGAL_PRIVACY_VERSION=enter-candidate-privacy-v1.0
LEGAL_TERMS_VERSION=enter-candidate-terms-v1.0
LEGAL_AGE_VERSION=enter-candidate-age-v1.0
LEGAL_SUBMISSION_VERSION=enter-candidate-submission-v1.0
LEGAL_PRIVACY_SHA256=
LEGAL_TERMS_SHA256=
LEGAL_AGE_SHA256=
LEGAL_SUBMISSION_SHA256=
CANDIDATE_REGISTRATION_COUNTRIES=
LEGAL_BUSINESS_HOLIDAYS=
RETENTION_REMINDER_DELIVERY_ENABLED=false
RETENTION_DELETION_ENABLED=false
ANCILLARY_RETENTION_ENABLED=false
RETENTION_REMINDER_MAX_ATTEMPTS=5

# Development uses the durable PostgreSQL queue. Production requires sqs.
RESUME_QUEUE_BACKEND=database
RESUME_SQS_QUEUE_URL=
AWS_SQS_REGION_NAME=ap-south-1
AWS_SQS_ENDPOINT_URL=
RESUME_JOB_MAX_ATTEMPTS=3
RESUME_RETRY_BASE_SECONDS=30
RESUME_PROCESSING_TIMEOUT_SECONDS=300
RESUME_WORKER_POLL_SECONDS=1
RESUME_SQS_WAIT_SECONDS=20
RESUME_SQS_VISIBILITY_TIMEOUT_SECONDS=360
AWS_SQS_CONNECT_TIMEOUT_SECONDS=2
AWS_SQS_READ_TIMEOUT_SECONDS=25
AWS_SQS_MAX_ATTEMPTS=2

# "development" performs format checks only and is rejected when DEBUG=false.
# Production should use clamav or a reviewed dotted scanner implementation.
RESUME_SCANNER_BACKEND=development
RESUME_SCAN_TIMEOUT_SECONDS=30
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310

LOGIN_RATE_LIMIT=10/min
SIGNUP_RATE_LIMIT=5/hour
VERIFICATION_RATE_LIMIT=5/hour
VERIFICATION_CONSUME_RATE_LIMIT=60/hour
PASSWORD_RESET_RATE_LIMIT=5/hour
PASSWORD_RESET_CONFIRM_RATE_LIMIT=30/hour
RESUME_UPLOAD_RATE_LIMIT=10/hour
RECRUITER_SEARCH_RATE_LIMIT=120/hour
# Enable only behind a proxy (such as an ALB) that appends the observed client IP.
RATE_LIMIT_TRUST_X_FORWARDED_FOR=false
LOG_LEVEL=INFO

# Recruiter natural-language search. Keys are backend-only secrets.
# Production must disable deterministic fallback.
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_SEARCH_MODEL=claude-sonnet-5-5
ANTHROPIC_API_BASE_URL=https://api.anthropic.com/v1
ANTHROPIC_API_VERSION=2023-06-01
ANTHROPIC_SEARCH_MAX_OUTPUT_TOKENS=2048


OPENAI_API_KEY=
OPENAI_SEARCH_MODEL=gpt-4o-mini
OPENAI_API_BASE_URL=https://api.openai.com/v1
AI_REQUEST_TIMEOUT_SECONDS=12
AI_ALLOW_DETERMINISTIC_FALLBACK=false

SECURE_SSL_REDIRECT=false
SECURE_HSTS_SECONDS=0
# Optional resume understanding (separate from recruiter search). Keep off until approved.
RESUME_AI_ENABLED=false
RESUME_AI_EXTERNAL_PROCESSING_APPROVED=false
RESUME_AI_PROVIDER=anthropic
# Set an exact model ID only after provider/privacy/budget approval.
RESUME_AI_MODEL=
RESUME_AI_API_KEY=
RESUME_AI_ALLOW_PAID=false
RESUME_AI_OPENAI_ZDR_APPROVED=false
RESUME_AI_GEMINI_FREE_TIER_APPROVED=false
RESUME_AI_FALLBACK=rules
RESUME_AI_MAX_ATTEMPTS=2
RESUME_AI_TIMEOUT_SECONDS=60
RESUME_AI_MAX_INPUT_TOKENS=4000
RESUME_AI_MAX_OUTPUT_TOKENS=8000
RESUME_AI_DAILY_BUDGET_USD=0
RESUME_AI_MONTHLY_BUDGET_USD=0
# Set from the provider's current official pricing when paid use is approved.
RESUME_AI_INPUT_USD_PER_MILLION=0
RESUME_AI_OUTPUT_USD_PER_MILLION=0
GEMINI_API_KEY=
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta
