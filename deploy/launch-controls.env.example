# Explicit approval required before copying to any server.
# CANDIDATE_ONLY is effective only when APP_ENV=production.
APP_ENV=production
CANDIDATE_ONLY=true
CANDIDATE_REGISTRATION_PAUSED=true
RESUME_UPLOADS_PAUSED=true
# Build the FRONTEND with --build-arg VITE_CANDIDATE_ONLY=true.
# Do not set LEGAL_CONTENT_APPROVED until the publication files say exactly
# PUBLICATION STATUS: APPROVED and their immutable hashes have been generated.
LEGAL_CONTENT_APPROVED=false
# Add to /etc/enter/ops.env only after backup/monitor approval:
ENTER_AWS_ACCOUNT=431988153216
ENTER_AWS_REGION=ap-southeast-2
ENTER_INSTANCE_ID=i-08f84202dbb6b4cce
ENTER_BACKUP_BUCKET=enter-staging-backups-2021
ENTER_BACKUP_SECURITY_REVIEWED=false
ENTER_BACKUP_STATE_FILE=/var/lib/enter-ops/backup-verified.json
ENTER_HTTPS_URL=https://enter.careers/api/v1/health/ready/
# Operator provisions private state directory and installs boto3 on host.
# ENTER_ALERT_TOPIC_ARN must refer to a confirmed operator-only SNS topic.
