# Copy to .env.production; chmod 600; never commit the populated file.
# Candidate-only production template. Keep both intake switches paused until the
# single launch check passes and final authorization is given.
APP_ENV=production
CANDIDATE_ONLY=true
CANDIDATE_REGISTRATION_PAUSED=true
RESUME_UPLOADS_PAUSED=true
CANDIDATE_REGISTRATION_COUNTRIES=IN
LEGAL_CONTENT_APPROVED=true
LEGAL_EFFECTIVE_DATE=2026-10-22
LEGAL_PRIVACY_VERSION=enter-candidate-privacy-v1.0
LEGAL_TERMS_VERSION=enter-candidate-terms-v1.0
LEGAL_AGE_VERSION=enter-candidate-age-v1.0
LEGAL_SUBMISSION_VERSION=enter-candidate-submission-v1.0
# Populate only from the exact approved UTF-8 release files/text. Startup and
# acceptance fail closed when any digest is missing or mismatched.
LEGAL_PRIVACY_SHA256=ebbafdb80abbcaf856490d1385b74b2cf8e15ec8826e7297753c836c7f8db49e
LEGAL_TERMS_SHA256=55b5b1ebca80a523218760499bedd2c93650b9ff04350f4355c483d313e825ef
LEGAL_AGE_SHA256=66b79e5cc63ddd3760ed02abb947604bf28ca152fc991dd09e59e5711e960bdf
LEGAL_SUBMISSION_SHA256=d1beaf60fbea2b351f039dc64f37a54e76d8e42083fe216da199ece72b1b70ba
ENTER_RELEASE=replace-with-reviewed-git-sha
# This tag applies to all five reviewed images: backend, frontend, scanner, edge, postgres.
# Proposed t3/t3a EC2 architecture. Rebuild/retest if choosing ARM/Graviton instead.
ENTER_PLATFORM=linux/amd64
ENTER_DOMAIN=enter.careers
ACME_EMAIL=replace-with-your-real-address
ENTER_DATA_DIR=/srv/enter-data
POSTGRES_PASSWORD=replace-with-new-random-hex-password
DATABASE_URL=postgresql://enter:replace-with-new-random-hex-password@db:5432/enter
DJANGO_SECRET_KEY=replace-with-at-least-50-random-characters
ALLOWED_HOSTS=enter.careers
FRONTEND_URL=https://enter.careers
CORS_ALLOWED_ORIGINS=https://enter.careers
CSRF_TRUSTED_ORIGINS=https://enter.careers
AWS_STORAGE_BUCKET_NAME=replace-with-private-resume-bucket
AWS_S3_REGION_NAME=ap-southeast-2
AWS_SQS_REGION_NAME=ap-southeast-2
RESUME_SQS_QUEUE_URL=https://sqs.ap-southeast-2.amazonaws.com/ACCOUNT/QUEUE
RESUME_PROCESS_HARD_TIMEOUT_SECONDS=240
RESUME_PROCESSING_TIMEOUT_SECONDS=300
RESUME_SQS_VISIBILITY_TIMEOUT_SECONDS=360
RESUME_PROCESS_MEMORY_MB=768
RESUME_QUEUE_ALERT_SECONDS=600
EMAIL_HOST=email-smtp.ap-southeast-2.amazonaws.com
EMAIL_PORT=587
EMAIL_HOST_USER=replace-with-ses-smtp-username
EMAIL_HOST_PASSWORD=replace-with-ses-smtp-password
DEFAULT_FROM_EMAIL=replace-with-approved-verified-sender
EMAIL_TIMEOUT=10
# Start with short HSTS; raise only after HTTPS has been validated.
SECURE_HSTS_SECONDS=300
SUBMISSION_CONSENT_VERSION=enter-candidate-submission-v1.0
LOG_LEVEL=INFO
